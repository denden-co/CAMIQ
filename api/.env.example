# CampaignIQ API — environment variables
# Copy to .env and fill in. Never commit the real .env.

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Local dev works without setting this. In production, set it to your
# frontend URL(s), e.g. https://campaigniq.vercel.app
#CORS_ORIGINS=https://your-frontend.example.com

# ── LLM providers (set whichever you use) ───────────────
# Personas + Strategic Advisor pick the first configured provider,
# or the one requested per call.
#GOOGLE_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=
#COHERE_API_KEY=
#HF_TOKEN=                 # HuggingFace router — Meta Llama, Qwen, etc.

# Custom OpenAI-compatible endpoint (e.g. local Ollama, vLLM)
#CUSTOM_LLM_BASE_URL=
#CUSTOM_LLM_API_KEY=
#CUSTOM_LLM_MODEL=
