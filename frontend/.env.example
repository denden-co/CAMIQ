# CampaignIQ frontend — environment variables
# Copy to .env.local and fill in. Never commit the real .env.local.

# ── API ─────────────────────────────────────────────────
# Base URL of the FastAPI backend. Defaults to http://localhost:8000
# in code, so local dev works without setting it. In production, set
# it to your deployed API URL, e.g. https://camiq-api.up.railway.app
#NEXT_PUBLIC_API_BASE_URL=

# ── Supabase (Phase 8 — real auth) ──────────────────────
# Required once Supabase auth replaces the dev-mock login.
#NEXT_PUBLIC_SUPABASE_URL=
#NEXT_PUBLIC_SUPABASE_ANON_KEY=
